# Copier ce fichier en `.env` et renseigner les vraies valeurs.
# En local avec LAMPP, les valeurs par défaut ci-dessous fonctionnent telles quelles.

# --- Base de données MySQL --------------------------------------------------
# Option A (recommandée si votre hébergeur fournit une URL unique, ex: Railway) :
DATABASE_URL="mysql://root:@localhost:3306/projetoff"
# Option B : variables séparées, utilisées uniquement si DATABASE_URL est absente.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=projetoff
DB_PORT=3306

# --- Backend Express (server.cjs) -------------------------------------------
# Port d'écoute. Railway (et la plupart des hébergeurs) définissent PORT
# automatiquement : ne pas le fixer en dur en production.
PORT=8080
# Origine(s) autorisée(s) en CORS pour le frontend, séparées par des virgules.
# En dev : http://localhost:3000. En prod : l'URL Netlify de votre site.
CORS_ORIGIN=http://localhost:3000
# Secret de signature des tokens JWT (obligatoire, doit être long et aléatoire).
JWT_SECRET=

# --- Emails (nodemailer, réinitialisation de mot de passe) ------------------
EMAIL_USER=
EMAIL_PASS=

# --- IA (assistant pédagogique parent) --------------------------------------
ANTHROPIC_API_KEY=

# --- Frontend Nuxt -----------------------------------------------------------
# URL publique du frontend (utilisée par certains liens générés côté serveur).
NUXT_PUBLIC_BASE_URL=http://localhost:3000
