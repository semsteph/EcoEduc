<template>
  <div v-if="isSupported" class="geometry-diagram" aria-label="Schéma géométrique">
    <svg
      class="geometry-svg"
      viewBox="0 0 430 300"
      role="img"
      preserveAspectRatio="xMidYMid meet"
    >
      <g v-if="diagram.type === 'parallelogram' && hasParallelogramPoints">
        <polygon
          :points="polygonPoints"
          class="shape"
        />

        <line
          v-for="segment in sideSegments"
          :key="segment.key"
          :x1="segment.a.x"
          :y1="segment.a.y"
          :x2="segment.b.x"
          :y2="segment.b.y"
          class="side"
        />

        <g v-if="diagram.labels !== false">
          <text
            v-for="(point, label) in orderedPoints"
            :key="`label-${label}`"
            :x="labelPosition(point, label).x"
            :y="labelPosition(point, label).y"
            class="point-label"
          >
            {{ label }}
          </text>
        </g>

        <g v-for="measurement in measurementEntries" :key="measurement.key">
          <text
            :x="measurement.position.x"
            :y="measurement.position.y"
            class="measurement-label"
          >
            {{ measurement.value }}
          </text>
        </g>
      </g>
    </svg>
  </div>
</template>

<script>
export default {
  name: "GeometryDiagram",

  props: {
    diagram: {
      type: Object,
      default: null,
    },
  },

  computed: {
    isSupported() {
      return this.diagram?.type === "parallelogram";
    },

    orderedPoints() {
      const points = this.diagram?.points || {};
      return {
        A: points.A,
        B: points.B,
        C: points.C,
        D: points.D,
      };
    },

    hasParallelogramPoints() {
      return ["A", "B", "C", "D"].every(
        (label) =>
          this.orderedPoints[label] &&
          Number.isFinite(Number(this.orderedPoints[label].x)) &&
          Number.isFinite(Number(this.orderedPoints[label].y))
      );
    },

    polygonPoints() {
      if (!this.hasParallelogramPoints) return "";

      return ["A", "B", "C", "D"]
        .map((label) => {
          const p = this.orderedPoints[label];
          return `${p.x},${p.y}`;
        })
        .join(" ");
    },

    sideSegments() {
      if (!this.hasParallelogramPoints) return [];

      const p = this.orderedPoints;
      return [
        { key: "AB", a: p.A, b: p.B },
        { key: "BC", a: p.B, b: p.C },
        { key: "CD", a: p.C, b: p.D },
        { key: "DA", a: p.D, b: p.A },
      ];
    },

    measurementEntries() {
      const measurements = this.diagram?.measurements || {};
      const entries = [];

      for (const [key, value] of Object.entries(measurements)) {
        const parts = key.split("-");
        if (parts.length !== 2) continue;

        const a = this.orderedPoints[parts[0]];
        const b = this.orderedPoints[parts[1]];
        if (!a || !b) continue;

        entries.push({
          key,
          value,
          position: {
            x: (Number(a.x) + Number(b.x)) / 2 + 8,
            y: (Number(a.y) + Number(b.y)) / 2 - 8,
          },
        });
      }

      return entries;
    },
  },

  methods: {
    labelPosition(point, label) {
      const offsets = {
        A: { x: -18, y: 20 },
        B: { x: -18, y: -10 },
        C: { x: 10, y: -10 },
        D: { x: 10, y: 20 },
      };

      const offset = offsets[label] || { x: 8, y: -8 };

      return {
        x: Number(point.x) + offset.x,
        y: Number(point.y) + offset.y,
      };
    },
  },
};
</script>

